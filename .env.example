# 서버의 .env 는 이 파일을 복사해서 값을 채운다. 실제 .env 는 커밋하지 않는다(.gitignore).
OPEN_DART_API_KEY=
OPEN_DART_BASE_URL=https://opendart.fss.or.kr/api
ECOS_API_KEY=
# 공공데이터포털 — 공휴일(천문연구원 특일 정보)만. 종목 목록은 hanjang/universe.txt (시세 API 안 씀)
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_BASE_URL=https://apis.data.go.kr/1160100/service
OPENAI_API_KEY=
# 32자 이상 무작위 — python -c "import secrets; print(secrets.token_hex(32))"
SECRET=
# 메일 링크에 들어가는 주소 (https 면 로그인 쿠키에 Secure 가 붙는다)
BASE_URL=https://hanjang.example.com
# 플레이스토어 앱(TWA)을 만든 뒤 — 패키지 이름과 서명 키 SHA-256 지문(여러 개면 쉼표). 넣으면 /.well-known/assetlinks.json 이 열린다
TWA_PACKAGE=
TWA_SHA256=
# 앱 심사자용 로그인 — 이 주소를 넣으면 메일을 보내지 않고, 아래 6자리 숫자로 들어온다(심사 메모에 둘 다 적는다 · 심사가 끝나면 비운다)
REVIEW_EMAIL=
REVIEW_CODE=
# Gmail: smtp.gmail.com · 587 · USER=내 Gmail 주소 · PASSWORD=앱 비밀번호 16자(2단계 인증 켠 뒤 myaccount.google.com/apppasswords) · FROM=한장 <내 Gmail 주소>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 개인정보 처리방침에 적힐 문의 메일 (비우면 「탈퇴하기」 안내만)
PRIVACY_CONTACT=
