# 화면 서버 — 늘 켜져 있고, 죽으면 다시 켠다. 127.0.0.1:8000 에서만 듣고 https 는 Caddy 가 맡는다.
[Unit]
Description=hanjang web
After=network-online.target

[Service]
User=hanjang
WorkingDirectory=/srv/hanjang
Environment=TZ=Asia/Seoul
ExecStart=/home/hanjang/.local/bin/uv run --frozen python -m hanjang.web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
